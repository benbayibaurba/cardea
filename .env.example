# docker compose knobs
TP_SIZE=1          # GPUs for tensor parallel
GPU_MEM_UTIL=0.9   # fraction of GPU memory vLLM may use; lower it if the card is shared
VLLM_PORT=8000   # host port for the model endpoint
APP_PORT=7860    # host port for the demo
# HF_HOME=   # optional: point at a host HF cache dir to reuse it; unset or empty uses a docker volume

# only needed when running outside docker: your vLLM endpoint
# CARDEA_BASE_URL=http://localhost:8000/v1
